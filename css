/* --- NOUVEAU STYLE.CSS : Thème Sombre et Vif --- */

/* Variables pour la cohérence des couleurs */
:root {
    --color-dark-main: #1a1a2e; /* Arrière-plan principal (Dark Blue) */
    --color-dark-secondary: #21213e; /* Arrière-plan des blocs/cartes */
    --color-text-light: #e0e0f0; /* Texte clair */
    --color-accent-green: #00bcd4; /* Accentuation (Cyan/Vert) */
    --color-accent-red: #ff4500; /* Accentuation secondaire (Orange/Rouge) */
    --color-button-primary: #8a2be2; /* Bouton Primaire (Violet) */
    --color-button-hover: #9932cc;
    --font-family: 'Segoe UI', Tahoma, Geneva, Verdana, sans-serif;
}

/* Réinitialisation de base */
body {
    font-family: var(--font-family);
    margin: 0;
    padding: 0;
    background-color: var(--color-dark-main);
    color: var(--color-text-light);
    line-height: 1.6;
}

/* En-tête */
.header {
    background-color: var(--color-dark-secondary);
    padding: 30px 0;
    text-align: center;
    box-shadow: 0 5px 15px rgba(0, 0, 0, 0.5);
    border-bottom: 2px solid var(--color-accent-green);
    position: relative; /* Pour positionner le bouton de retour sur morpion.html */
}

.header h1 {
    margin-bottom: 5px;
    color: var(--color-accent-green);
    text-shadow: 0 0 10px rgba(0, 188, 212, 0.8); /* Effet néon */
}

/* Conteneur principal */
.game-container, .game-area {
    max-width: 1200px;
    margin: 40px auto;
    padding: 0 20px;
}

.game-container h2 {
    color: var(--color-accent-red);
    border-bottom: 2px solid var(--color-accent-red);
    padding-bottom: 10px;
    margin-bottom: 30px;
    text-align: center;
}

/* Liste des jeux (Cartes) */
.game-list {
    display: flex;
    flex-wrap: wrap;
    gap: 40px;
    justify-content: center;
}

/* Carte de jeu */
.game-card {
    background-color: var(--color-dark-secondary);
    border: 1px solid var(--color-dark-secondary);
    border-radius: 12px;
    padding: 20px;
    width: 300px;
    box-shadow: 0 5px 15px rgba(0, 0, 0, 0.4);
    text-align: center;
    transition: transform 0.3s ease, box-shadow 0.3s ease;
}

.game-card:hover {
    transform: translateY(-8px) scale(1.02); 
    box-shadow: 0 10px 25px rgba(0, 0, 0, 0.6);
    border-color: var(--color-accent-green);
}

.game-card h3 {
    color: var(--color-accent-green); 
    margin-top: 0;
    border-bottom: 1px dashed var(--color-text-light);
    padding-bottom: 10px;
}

.play-button {
    display: block; /* Prend toute la largeur de la carte */
    background-color: var(--color-button-primary); 
    color: white;
    padding: 12px 20px;
    margin-top: 15px;
    border-radius: 8px;
    text-decoration: none;
    font-weight: bold;
    text-transform: uppercase;
    transition: background-color 0.2s;
}

.play-button:hover {
    background-color: var(--color-button-hover);
}

/* Bouton "Bientôt Disponible" */
.coming-soon {
    background-color: #555; 
    cursor: not-allowed;
    pointer-events: none; /* Rendre le clic impossible */
}

.coming-soon:hover {
    background-color: #555; 
}

/* Affichage du score */
.score-display {
    margin-top: 10px;
    font-size: 0.9em;
    color: var(--color-accent-red);
}

/* Pied de page */
.footer {
    text-align: center;
    padding: 15px 0;
    margin-top: 40px;
    background-color: #111; 
    color: #777;
    font-size: 0.8em;
    border-top: 1px solid #333;
}

/* --- Styles Spécifiques au Morpion (morpion.html) --- */

.game-area {
    display: flex;
    flex-direction: column;
    align-items: center;
    text-align: center;
}

.back-button {
    position: absolute;
    top: 35px;
    left: 40px;
    background-color: var(--color-accent-red); 
    padding: 8px 15px;
    border-radius: 5px;
    text-decoration: none;
    color: white;
    font-weight: bold;
    transition: background-color 0.2s;
}

.back-button:hover {
    background-color: #cc3700;
}

/* La Grille du Morpion */
.morpion-grid {
    display: grid;
    grid-template-columns: repeat(3, 120px); /* Cases un peu plus grandes */
    grid-template-rows: repeat(3, 120px);
    gap: 8px; /* Écart plus large */
    background-color: var(--color-dark-main); 
    padding: 10px;
    border-radius: 15px;
    margin: 30px 0;
    box-shadow: 0 0 30px rgba(0, 188, 212, 0.4); /* Ombre néon */
}

/* Les cellules (cases) */
.cell {
    background-color: var(--color-dark-secondary); 
    display: flex;
    justify-content: center;
    align-items: center;
    font-size: 4em; /* Symbole plus grand */
    font-weight: bold;
    cursor: pointer;
    transition: background-color 0.2s, transform 0.1s;
    border-radius: 8px;
    border: 2px solid #333;
}

.cell:hover:not(.x):not(.o) {
    background-color: #333355; 
    transform: scale(1.05);
}

/* Style des symboles X et O */
.cell.x {
    color: var(--color-accent-red); 
    text-shadow: 0 0 10px var(--color-accent-red);
}

.cell.o {
    color: var(--color-accent-green); 
    text-shadow: 0 0 10px var(--color-accent-green);
}

/* Information du jeu et Bouton Reset */
#game-status {
    font-size: 1.5em;
    font-weight: bold;
    margin-bottom: 20px;
    color: var(--color-text-light);
}

#reset-button {
    padding: 12px 25px;
    background-color: var(--color-accent-red); 
    color: white;
    border: none;
    border-radius: 8px;
    cursor: pointer;
    font-size: 1.1em;
    transition: background-color 0.2s;
    box-shadow: 0 4px #cc3700;
}

#reset-button:hover {
    background-color: #cc3700;
    box-shadow: 0 2px #cc3700;
    transform: translateY(2px);
}

/* Tableau des scores */
.score-board {
    background-color: var(--color-dark-secondary);
    padding: 20px 40px;
    border-radius: 12px;
    box-shadow: 0 0 10px rgba(0, 0, 0, 0.5);
    text-align: center;
    margin-top: 30px;
    border-left: 5px solid var(--color-button-primary);
}
