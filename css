/* --- Styles Spécifiques au Morpion (Ajouter à style.css) --- */

.game-area {
    display: flex;
    flex-direction: column;
    align-items: center;
    margin-top: 30px;
}

.back-button {
    position: absolute;
    top: 25px;
    left: 20px;
    background-color: #f39c12; /* Orange */
    padding: 8px 15px;
    border-radius: 5px;
    text-decoration: none;
    color: white;
    font-weight: bold;
}

/* La Grille du Morpion */
.morpion-grid {
    display: grid;
    /* Crée une grille de 3x3 */
    grid-template-columns: repeat(3, 100px); 
    grid-template-rows: repeat(3, 100px);
    gap: 5px;
    background-color: #2c3e50; /* Couleur sombre du cadre */
    padding: 5px;
    border-radius: 10px;
    margin: 20px 0;
    box-shadow: 0 0 20px rgba(0, 0, 0, 0.2);
}

/* Les cellules (cases) */
.cell {
    background-color: #ecf0f1; /* Gris clair de la cellule */
    display: flex;
    justify-content: center;
    align-items: center;
    font-size: 3em;
    font-weight: bold;
    cursor: pointer;
    transition: background-color 0.15s;
    border-radius: 5px;
}

.cell:hover:not(.x):not(.o) {
    background-color: #bdc3c7; /* Assombrissement au survol */
}

/* Style des symboles X et O */
.cell.x {
    color: #e74c3c; /* Rouge pour X */
}

.cell.o {
    color: #3498db; /* Bleu pour O */
}

/* Information du jeu et Bouton Reset */
#game-status {
    font-size: 1.2em;
    font-weight: bold;
    margin-bottom: 15px;
    color: #2c3e50;
}

#reset-button {
    padding: 10px 20px;
    background-color: #e67e22; /* Orange plus foncé */
    color: white;
    border: none;
    border-radius: 5px;
    cursor: pointer;
    font-size: 1em;
    transition: background-color 0.2s;
}

#reset-button:hover {
    background-color: #d35400;
}

/* Tableau des scores */
.score-board {
    background-color: white;
    padding: 15px 30px;
    border-radius: 8px;
    box-shadow: 0 2px 5px rgba(0, 0, 0, 0.1);
    text-align: center;
    margin-top: 20px;
}
