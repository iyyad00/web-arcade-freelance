/* Réinitialisation de base */
body {
    font-family: Arial, sans-serif;
    margin: 0;
    padding: 0;
    background-color: #f4f4f9;
    color: #333;
    line-height: 1.6;
}

/* En-tête */
.header {
    background-color: #3498db; /* Bleu vif */
    color: white;
    padding: 20px 0;
    text-align: center;
    box-shadow: 0 4px 6px rgba(0, 0, 0, 0.1);
}

.header h1 {
    margin-bottom: 5px;
}

/* Conteneur principal */
.game-container {
    max-width: 1200px;
    margin: 30px auto;
    padding: 0 20px;
}

.game-container h2 {
    border-bottom: 2px solid #3498db;
    padding-bottom: 10px;
    margin-bottom: 20px;
}

/* Liste des jeux (Utilisation de Flexbox pour l'alignement) */
.game-list {
    display: flex;
    flex-wrap: wrap;
    gap: 30px;
    justify-content: center;
}

/* Carte de jeu */
.game-card {
    background-color: white;
    border: 1px solid #ddd;
    border-radius: 8px;
    padding: 20px;
    width: 300px;
    box-shadow: 0 2px 5px rgba(0, 0, 0, 0.1);
    text-align: center;
    transition: transform 0.2s;
}

.game-card:hover {
    transform: translateY(-5px); /* Petit effet de soulèvement au survol */
    box-shadow: 0 4px 10px rgba(0, 0, 0, 0.15);
}

.game-card h3 {
    color: #e74c3c; /* Rouge */
    margin-top: 0;
}

.play-button {
    display: inline-block;
    background-color: #2ecc71; /* Vert */
    color: white;
    padding: 10px 20px;
    margin-top: 15px;
    border-radius: 5px;
    text-decoration: none;
    font-weight: bold;
    transition: background-color 0.2s;
}

.play-button:hover {
    background-color: #27ae60;
}

/* Bouton "Bientôt Disponible" */
.coming-soon {
    background-color: #95a5a6; /* Gris pour indisponible */
    cursor: not-allowed;
}

.coming-soon:hover {
    background-color: #95a5a6; 
}

/* Affichage du score */
.score-display {
    margin-top: 10px;
    font-size: 0.9em;
    color: #7f8c8d;
}

/* Pied de page */
.footer {
    text-align: center;
    padding: 15px 0;
    margin-top: 40px;
    background-color: #2c3e50; /* Gris foncé */
    color: white;
    font-size: 0.8em;
}
